# Copiar para .env.local e preencher com os dados do projeto Supabase
# (Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave pública ("publishable" ou "anon"). Pode estar no browser: o acesso
# é limitado pelas regras em supabase/schema.sql. Nunca usar a "secret"/"service_role".
NEXT_PUBLIC_SUPABASE_KEY=
